  },
  "item": [
    {
      "name": "1. Create route",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/routes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "routes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source\": \"Chennai\",\n  \"destination\": \"Coimbatore\",\n  \"trainList\": [\n    {\n      \"trainName\": \"Kovai Express\",\n      \"arrivalTime\": \"06:00:00\",\n      \"departureTime\": \"06:10:00\",\n      \"fare\": 650.5\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. View route 101",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/routes/101",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "routes",
            "101"
          ]
        }
      }
    },
    {
      "name": "3. Trains Bangalore->Chennai",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/routes/trains?source=Bangalore&destination=Chennai",
